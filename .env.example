# Параметры подключения к БД. Скопировать в .env и заполнить своими значениями:
#   cp .env.example .env && set -a && source .env && set +a
#
# Пароля в коде проекта нет нигде: пайплайн и ноутбук читают его только отсюда,
# а в Airflow он хранится в Connection project_dq_postgres.

DQ_PG_HOST=localhost
DQ_PG_PORT=5432
DQ_PG_USER=postgres
DQ_PG_PASSWORD=
DQ_PG_DBNAME=Project_DQ

# Soda Core использует собственные переменные (см. checks/configuration.yml)
SODA_PG_HOST=localhost
SODA_PG_PASSWORD=
